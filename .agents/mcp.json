{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"]
    },
    "mercadolibre-mcp-server": {
      "url": "https://mcp.mercadolibre.com/mcp",
      "headers": {
        "Authorization": "Bearer ${MERCADOLIBRE_ACCESS_TOKEN}"
      }
    }
  }
}
