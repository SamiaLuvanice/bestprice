POSTGRES_DB=bestprice
POSTGRES_USER=bestprice
POSTGRES_PASSWORD=troque-esta-senha
# Portas publicadas apenas em localhost pelo Compose.
BACKEND_PORT=8000
FRONTEND_PORT=5173
DB_PORT=5433
# Ative somente após confirmar oficialmente acesso a anúncios de terceiros.
MERCADOLIVRE_THIRD_PARTY_VALIDATED=false
# Cliente OAuth da conta operadora. Gere uma chave Fernet única e guarde-a fora do repositório.
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
MERCADOLIVRE_OAUTH_KEY=
# Configure uma URL HTTPS registrada no DevCenter para autorizar uma conta operadora.
MERCADOLIVRE_REDIRECT_URI=
# Só IDs de anúncios de terceiros cuja consulta foi autorizada pela conta operadora.
# Usados pela sonda manual; cada cenário precisa de um ID MLB diferente.
MERCADOLIVRE_VALIDATION_PRICE_ITEM_ID=
MERCADOLIVRE_VALIDATION_NO_PRICE_ITEM_ID=
MERCADOLIVRE_VALIDATION_UNAVAILABLE_ITEM_ID=
APP_ENV=development
# IA desativada por padrão. Use somente projeto gratuito sem faturamento; sem fallback pago.
AI_ENABLED=false
GEMINI_API_KEY=
# Pesquisa na web (grounding Google Search) no chat; free tier só no gemini-2.5-flash-lite.
AI_WEB_SEARCH_ENABLED=false
# Ajuste após validar os limites reais da integração autorizada.
MONITOR_CHECK_INTERVAL_SECONDS=3600
MONITOR_FRESHNESS_SECONDS=3600
MONITOR_BATCH_LIMIT=20
MONITOR_MAX_CONCURRENCY=1
MONITOR_POLL_INTERVAL_SECONDS=60
# Cadastro self-service (spec 0048). Desligado por padrão; só "true" liga.
SIGNUP_ENABLED=false
# Tentativas de cadastro por origem na janela (inclui sucessos, duplicados e erros de validação).
SIGNUP_RATE_LIMIT_ATTEMPTS=5
SIGNUP_RATE_LIMIT_WINDOW_MINUTES=60
# Segredo compartilhado com o proxy do Pages (API_PROXY_SECRET). Obrigatório em stage/production
# (o limite de login está sempre ligado, spec 0057); mínimo 32 caracteres. Gere um valor
# aleatório e guarde fora do repositório.
TRUSTED_PROXY_SECRET=
# Chave do HMAC-SHA256 da origem e do e-mail nos limites de cadastro e de login (nunca gravados
# em claro). Obrigatório em stage/production e com o cadastro ligado; mínimo 32 caracteres,
# distinto dos demais segredos. Localmente, vazio gera um segredo aleatório por processo.
SIGNUP_SOURCE_HASH_SECRET=
# Limite de falhas de login (spec 0057): por origem + e-mail (1–1000) e por origem (1–10000,
# nunca menor que o anterior), numa janela de 1–1440 minutos. Recusas não contam.
LOGIN_RATE_LIMIT_ACCOUNT_ATTEMPTS=10
LOGIN_RATE_LIMIT_SOURCE_ATTEMPTS=50
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
