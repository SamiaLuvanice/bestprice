POSTGRES_DB=bestprice
POSTGRES_USER=bestprice
POSTGRES_PASSWORD=troque-esta-senha
# Portas publicadas apenas em localhost pelo Compose.
BACKEND_PORT=8000
FRONTEND_PORT=5173
DB_PORT=5433
# Ative somente após confirmar oficialmente acesso a anúncios de terceiros.
MERCADOLIVRE_THIRD_PARTY_VALIDATED=false
# Cliente OAuth da conta operadora. Gere uma chave Fernet única e guarde-a fora do repositório.
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
MERCADOLIVRE_OAUTH_KEY=
APP_ENV=development
# Ajuste após validar os limites reais da integração autorizada.
MONITOR_CHECK_INTERVAL_SECONDS=3600
MONITOR_FRESHNESS_SECONDS=3600
MONITOR_BATCH_LIMIT=20
MONITOR_MAX_CONCURRENCY=1
MONITOR_POLL_INTERVAL_SECONDS=60
